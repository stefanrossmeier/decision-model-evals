#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_common.sh"
need_uv
model="${1:-}"
suite="${2:-core}"
if [[ -z "$model" ]]; then
  echo "usage: scripts/run-benchmark MODEL [SUITE] [extra decision-evals args...]" >&2
  exit 2
fi
shift || true
shift || true
cd "$ROOT"
exec uv run decision-evals run --model "$model" --suite "$suite" "$@"
