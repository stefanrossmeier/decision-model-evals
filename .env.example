# Required only for hosted Jev.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=decision-model-evals

# Optional local endpoint overrides.
DECIDER_URL=http://127.0.0.1:8011/v1/systemone
SEMIF_URL=http://127.0.0.1:8012/v1/systemone

# SemIf adapter device: auto (Mac arm64 -> MPS; otherwise CUDA), mps, cuda, or cpu.
SEMIF_DEVICE=auto

# Optional modeled local compute cost; local provider cost remains $0.
LOCAL_COMPUTE_USD_PER_HOUR=
